      "html": "<aside class=\"ds-pc\"><div class=\"ds-pc-head\"><div><h2>PeterMD</h2><p class=\"ds-why\">Lowest first-year cost confirmed for Texas</p></div><span class=\"ds-total\">$1,548</span></div><ul class=\"ds-lines\"><li><span>Membership</span><b>$948</b></li><li><span>Labs (estimate)</span><b>$300</b></li><li><span>Startup fees</span><b>$300</b></li></ul><p class=\"ds-foot\">Checked Nov 3, 2026 · <a href=\"#\">Source</a></p><a class=\"ds-link\" href=\"#\">Compare all 4 confirmed for Texas<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 12h13M13 6l6 6-6 6\"/></svg></a></aside>",
      "css": ".ds-pc{max-width:380px;background:var(--surface,#111a2b);color:var(--ink,#e9eef7);border:1px solid var(--line,#233049);border-radius:20px;padding:24px 24px 20px;box-shadow:var(--shadow-lg,0 1px 2px rgba(0,0,0,.35),0 24px 48px -24px rgba(0,0,0,.6));font:16px/1.6 Archivo,system-ui,sans-serif}.ds-pc-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;padding-bottom:14px;border-bottom:1px solid var(--line,#233049)}.ds-pc h2{margin:0;font-size:26px;line-height:1.15;font-weight:850;font-variation-settings:\"wdth\" 80}.ds-why{margin:2px 0 0;font-size:13.5px;font-weight:600;color:var(--ok,#4fc98f)}.ds-total{font-size:40px;font-weight:850;font-variation-settings:\"wdth\" 75;font-variant-numeric:tabular-nums;letter-spacing:-.01em}.ds-lines{list-style:none;margin:10px 0 0;padding:0;font-size:14.5px}.ds-lines li{display:flex;justify-content:space-between;padding:6px 0;color:var(--muted,#9ba7bd)}.ds-lines b{color:var(--ink,#e9eef7);font-weight:600;font-variant-numeric:tabular-nums}.ds-foot{font-size:13px;color:var(--muted,#9ba7bd);margin:10px 0 14px}.ds-pc a{color:var(--link,#9cbcff)}.ds-link{display:inline-flex;align-items:center;gap:4px;min-height:44px;font-weight:650;text-decoration:none}.ds-link svg{width:1em;height:1em;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}.ds-link:hover{color:var(--accent-hover,#bfd3ff)}"
