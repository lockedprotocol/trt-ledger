        "displayName": "Headline",
        "purpose": "Section heads and the alert band heading; wdth 75."
      },
      "title": {
        "displayName": "Title",
        "purpose": "Clinic names (wdth 88), summary and group heads (wdth 85)."
      },
      "figure": {
        "displayName": "Figure",
        "purpose": "Every first-year total, lab total and stat; tabular, condensed. 40px on the hero price card."
      },
      "body": {
        "displayName": "Body",
        "purpose": "Paragraphs and lists at regular width; ledes 17-18.5px muted."
      },
      "label": {
        "displayName": "Label",
        "purpose": "Form labels, notes, checked dates and source lines in muted ink."
      },
      "tag": {
        "displayName": "Tag",
        "purpose": "Pill tags and count badges."
      }
    },
